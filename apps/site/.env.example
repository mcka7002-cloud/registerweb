NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# ลิงก์ปุ่ม "สมัครเรียน" ไปฟอร์มลงทะเบียนใน apps/web
NEXT_PUBLIC_REGISTER_URL=http://localhost:3000/register
# ที่อยู่แอป apps/web (ใช้ทำลิงก์ประกาศความเป็นส่วนตัว /privacy) ถ้าว่างจะใช้ origin ของ NEXT_PUBLIC_REGISTER_URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
