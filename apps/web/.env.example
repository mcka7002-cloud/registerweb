# คัดลอกเป็น .env.local แล้วใส่ค่าจาก `supabase status` (local) หรือ Supabase dashboard (dev/prod)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ใช้ฝั่ง server เท่านั้น ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ และห้าม commit
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# สาขาตั้งต้นของฟอร์มลงทะเบียนสาธารณะ (/register?branch=<id> ใช้แทนได้)
NEXT_PUBLIC_DEFAULT_BRANCH_ID=

# Google OAuth (ล็อกอิน Gmail ทุก role) ตั้งใน Supabase Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 1 = แสดงฟอร์มอีเมล + รหัสผ่านที่หน้า /login (ผู้ใช้ทดสอบใน seed, local dev เท่านั้น ห้ามเปิดบน production)
NEXT_PUBLIC_DEV_LOGIN=
