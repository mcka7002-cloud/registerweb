// Cloudflare Workers config for apps/web (OpenNext). See docs/adr/0002-hosting-cloudflare.md.
// Top level = local preview (`pnpm preview`). Deploys use --env staging | production, which name the
// Worker registerweb-web-staging / registerweb-web-production.
// Custom domains: add "routes": [{ "pattern": "<host>", "custom_domain": true }] per env once the school's
// domain is on Cloudflare (docs/deploy-th.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "registerweb-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Slips and student photos (lib/files). Bindings are not inherited, so each env names its own bucket.
  // Backups go to a separate bucket written only by GitHub Actions; the Worker has no binding to it.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "registerweb-files-local" }],
  "env": {
    "staging": {
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "registerweb-files-staging" }]
    },
    "production": {
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "registerweb-files" }]
    }
  }
}
